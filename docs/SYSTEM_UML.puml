@startuml
!pragma layout smetana

title Σύστημα Έξυπνων Ανελκυστήρων\nΠαρούσα και προγραμματισμένη κατάσταση

top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName Arial

legend right
  |= Μορφή |= Σημασία |
  | Πράσινο | Υλοποιείται / υπάρχει αρχικός κώδικας |
  | Γαλάζιο | Υπάρχει σχεδιασμός και API contract |
  | Διακεκομμένο βέλος | Προγραμματισμένη REST ενοποίηση |
endlegend

package "Σύστημα Έξυπνων Ανελκυστήρων" {

    component "Πληκτρολόγιο Χρήστη\n(Kiosk)" as Kiosk #D5F5E3
    component "Κεντρικό Σύστημα\nDispatch και διαχείριση" as Central #D6EAF8
    component "Ανελκυστήρας\nΚίνηση, πόρτες, αισθητήρες" as Elevator #D5F5E3
    component "Σύστημα Αξιολόγησης\nΣενάρια, KPIs, αποτελέσματα" as Evaluation #D5F5E3

    Kiosk ..> Central : POST /requests
    Central ..> Kiosk : POST /display

    Central ..> Elevator : GET /state
    Central ..> Elevator : POST /stops
    Central ..> Elevator : POST /stop
    Central ..> Elevator : POST /resume
    Central ..> Elevator : PUT /config

    Evaluation ..> Central : POST /requests
    Evaluation ..> Central : GET /elevators
    Evaluation ..> Central : GET /config
    Evaluation ..> Central : PUT /config

    Elevator ..> Evaluation : POST /events
}

note left of Kiosk
  Παρούσα κατάσταση:
  - σχεδιασμός ροής χρήστη
  - Request model
  - KioskController
end note

note right of Evaluation
  Παρούσα κατάσταση:
  - Evaluation REST server
  - POST /events
  - POST /metrics
  - JSON με Jackson
  - έλεγχος χωρητικότητας
end note

note right of Central
  Προγραμματισμένη κατάσταση:
  - αλγόριθμος dispatch
  - συλλογή καταστάσεων
  - ανάθεση ανελκυστήρα
  - πλήρης REST ενοποίηση
end note

note left of Elevator
  Παρούσα κατάσταση:
  - κανόνες λειτουργίας
  - καταστάσεις ασφαλείας

  Προγραμματισμένα:
  - σύνδεση κινητήρα
  - σύνδεση θυρών
  - σύνδεση αισθητήρων
end note

package "Προγραμματισμένοι έλεγχοι" #F2F3F4 {
    component "Integration Tests" as Integration
    component "System Tests" as SystemTests
    component "Performance Tests" as Performance
}

Central ..> Integration
Elevator ..> Integration
Kiosk ..> SystemTests
Evaluation ..> SystemTests
SystemTests ..> Performance

@enduml 